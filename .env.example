# sepolia (identity + attestations)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
PROBER_PRIVATE_KEY=

# hedera testnet (x402 payments)
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Base mainnet (one explicitly enabled external x402 probe; canonical USDC only)
BASE_PRIVATE_KEY=
PROBE_EXTERNAL=0
# Comma-separated curated providers. Adding an adapter alone never enables spend.
EXTERNAL_FEED_ALLOWLIST=tickersfeed
# Aggregate Base USDC caps in atomic units (6 decimals): $0.05/round, $0.10/day.
# Hard code ceilings prevent configuration above $0.10/round or $0.25/day.
BASE_ROUND_BUDGET_ATOMIC=50000
BASE_DAILY_BUDGET_ATOMIC=100000
# Optional; defaults to .agentindex/base-spend-ledger.json (gitignored, mode 0600).
BASE_SPEND_LEDGER_PATH=

# deployed addresses (filled by deploy scripts)
ATTESTATION_REGISTRY_ADDRESS=
SUBNAME_REGISTRAR_ADDRESS=

# graph
SUBGRAPH_DEPLOYMENT_ID=
SUBGRAPH_QUERY_URL=

# The Graph Token API oracle (JWT from thegraph.market, never the raw API key)
THEGRAPH_TOKEN_API_KEY=
ORACLE_TOLERANCE_BPS=200
CONSENSUS_TOLERANCE_BPS=200

# Remote MCP transport
MCP_PORT=8787
PUBLIC_MCP_URL=http://localhost:8787
NEXT_PUBLIC_MCP_URL=http://localhost:8787/mcp
